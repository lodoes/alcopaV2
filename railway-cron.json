{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node cron-all-sales.mjs",
    "cronSchedule": "15 2 * * *",
    "healthcheckPath": null,
    "restartPolicyType": "NEVER",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    }
  }
}
